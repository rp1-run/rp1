{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '${RP1_BINARY:-rp1} arcade --no-open --format hook-json 2>/dev/null || true'",
            "statusMessage": "Starting rp1 Arcade",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '${RP1_BINARY:-rp1} update --check --format hook-text 2>/dev/null | { read -r msg; [ -n \"$msg\" ] && printf \"{\\\"systemMessage\\\":\\\"🚀 %s\\\"}\" \"$msg\" || true; }'",
            "statusMessage": "Checking for rp1 updates",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
