{
  "schemaVersion": 1,
  "plugin": "{{ namespacedPluginName }}",
  "platform": {
    "id": "antigravity",
    "name": "Antigravity CLI",
    "binary": "agy"
  },
  "supportMatrix": "support-matrix.json",
  "supportMetadata": "support-metadata.json",
  "mcpConfig": "mcp_config.json",
  "runtime": {
    "currentHost": "antigravity",
    "bootstrapHarness": "antigravity",
    "rootContract": {
      "sourceOperations": "codeRoot",
      "knowledgeReads": "kbRoot",
      "durableArtifacts": "workRoot",
      "worktreeSplit": "preserve"
    },
    "unsupportedModePolicy": "block_or_label_antigravity_support_exception",
    "unsupportedModes": [
      "permissions",
      "trust",
      "sandbox",
      "headless",
      "mcp",
      "workspace",
      "nested-delegation"
    ],
    "staticAgentsDiscovery": "not_used"
  },
  "hooks": "hooks/hooks.json",
  "rules": [
    "rules/rp1-rules.md"
  ],
  "commands": [
{%- for command in artifact.commands %}
    "{{ command }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "commandFiles": [
{%- for commandFile in artifact.commandFiles %}
    {
      "name": "{{ commandFile.name }}",
      "path": "{{ commandFile.path }}"
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "skills": [
{%- for skill in artifact.skills %}
    "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "staticAgentFiles": [
{%- for agent in artifact.agents %}
    "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "delegation": {
    "definitionIndex": "delegation-definitions/index.json",
    "runtimeContract": "define_subagent_once_per_session_then_invoke_subagent",
    "staticAgentsDiscovery": "not_used",
    "definitions": [
{%- for definition in artifact.delegationDefinitions %}
      {
        "rp1AgentId": "{{ definition.rp1AgentId }}",
        "definitionHash": "{{ definition.definitionHash }}",
        "typeName": "{{ definition.typeName }}",
        "path": "{{ definition.path }}",
        "workspace": {
          "defaultPolicy": "{{ definition.workspace.defaultPolicy }}",
          "isolatedWorktree": "{{ definition.workspace.isolatedWorktree }}"
        },
        "tools": {
          "enable_mcp_tools": {{ definition.tools.enable_mcp_tools }},
          "enable_write_tools": {{ definition.tools.enable_write_tools }},
          "enable_subagent_tools": {{ definition.tools.enable_subagent_tools }}
        },
        "nestedDelegation": {
          "sourceUsesSubagents": {{ definition.nestedDelegation.sourceUsesSubagents }},
          "enabled": {{ definition.nestedDelegation.enabled }},
          "validation": "{{ definition.nestedDelegation.validation }}"
        }
      }{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ]
  }
}
