{
  "plugin": "{{ pluginName }}",
  "version": "{{ version }}",
  "opencodeVersionTested": "0.9.x",
  "artifacts": {
    "commands": [
{%- for cmd in artifact.commands %}
      "{{ cmd }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "agents": [
{%- for agent in artifact.agents %}
      "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "skills": [
{%- for skill in artifact.skills %}
      "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ]
  },
  "installation": {
    "agentsDir": "~/.config/opencode/agents/",
    "skillsDir": "~/.config/opencode/skills/"
  },
  "requirements": {
    "opencodeVersion": ">=0.8.0"
  }
{%- if artifact.hasOpenCodePlugin %},
  "hasOpenCodePlugin": true
{%- endif %}
}