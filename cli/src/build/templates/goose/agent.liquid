---
name: {{ namespacedPluginName }}-{{ artifact.name }}
description: {{ artifact.description | escape_yaml }}
{%- if artifact.model != "inherit" %}
model: {{ artifact.model | escape_yaml }}
{%- endif %}
{%- assign extensions = artifact.tools | join: ", " | allowed_tools: platform %}
{%- if extensions and extensions.size > 0 %}
tools:
{%- for extension in extensions %}
  - {{ extension | escape_yaml }}
{%- endfor %}
{%- else %}
tools: []
{%- endif %}
metadata:
  rp1:
    plugin: {{ pluginName }}
    name: {{ artifact.name }}
    harness: goose
---

