{% assign rawPluginName = pluginName | replace_first: "rp1-", "" -%}
{
  "plugin": "{{ rawPluginName }}",
  "nativePluginName": "rp1-{{ rawPluginName }}",
  "version": "{{ version }}",
  "gooseVersionTested": "{{ platformConfig.min_version }}",
  "supportScope": "generated-core-harness-assets",
  "artifacts": {
    "agents": [
{%- for agent in artifact.agents %}
      "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "skills": [
{%- for skill in artifact.skills %}
      "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "recipes": [
{%- for skill in artifact.skills %}
      "rp1-{{ rawPluginName }}-{{ skill | replace_first: "rp1-", "" }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "supportMetadata": "support-metadata.json"
  },
  "installation": {
    "method": "manifest-owned-goose-assets",
    "skillsDir": "skills/",
    "agentsDir": "agents/",
    "recipesDir": "recipes/"
  },
  "requirements": {
    "gooseVersion": ">={{ platformConfig.min_version }}",
    "extensions": ["developer"]
  }
}
