{
  "plugin": "{{ pluginName }}",
  "nativePluginName": "{% if pluginName contains 'rp1-' %}{{ pluginName }}{% else %}{{ namespacedPluginName }}{% endif %}",
  "version": "{{ version }}",
  "geminiVersionTested": "extension-format-v0.4.0",
  "artifacts": {
    "commands": [
{%- for cmd in artifact.commands %}
      "{{ cmd }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "agents": [
{%- for agent in artifact.agents %}
      "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "skills": [
{%- for skill in artifact.skills %}
      "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "supportMatrix": "support-matrix.json"
  },
  "installation": {
    "method": "gemini-extension",
    "extensionDir": "~/.gemini/extensions/{% if pluginName contains 'rp1-' %}{{ pluginName }}{% else %}{{ namespacedPluginName }}{% endif %}",
    "contextFile": "GEMINI.md",
    "extensionManifest": "gemini-extension.json"
  },
  "requirements": {
    "geminiCli": ">=0.4.0"
  }
}
