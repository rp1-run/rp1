{
  "plugin": "{{ pluginName }}",
  "nativePluginName": "{% if pluginName contains 'rp1-' %}{{ pluginName }}{% else %}{{ namespacedPluginName }}{% endif %}",
  "version": "{{ version }}",
  "copilotVersionTested": "2.74.x",
  "artifacts": {
    "commands": [
{%- for cmd in artifact.commands %}
      "{{ cmd }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "agents": [
{%- for agent in artifact.agents %}
      "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "skills": [
{%- for skill in artifact.skills %}
      "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ]
  },
  "installation": {
    "method": "native-plugin-marketplace",
    "marketplaceDir": "~/.rp1/copilot/marketplace",
    "installedPluginsDir": "~/.copilot/installed-plugins/"
  },
  "requirements": {
    "copilotVersion": ">=2.74.0",
    "pluginCommands": true
  }
}
