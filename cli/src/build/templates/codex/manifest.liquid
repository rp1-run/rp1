{
  "plugin": "{{ pluginName }}",
  "version": "{{ version }}",
  "codexVersionTested": "0.1.x",
  "artifacts": {
    "skills": [
{%- for skill in artifact.skills %}
      "{{ skill }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ],
    "agents": [
{%- for agent in artifact.agents %}
      "{{ agent }}"{% unless forloop.last %},{% endunless %}
{%- endfor %}
    ]
  },
  "installation": {
    "skillsDir": "~/.codex/skills/",
    "configFile": "~/.codex/config.toml"
  }
}