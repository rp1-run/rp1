*.swp
*.swo
*~
.vscode/
.idea/
node_modules/

# Build artifacts
dist/

# rp1 work directory (features, archives, scratch)
.rp1/work/

# MkDocs build output
site/

# Python cache
__pycache__/
*.pyc

# Miscellaneous
.playwright-mcp

# Package lock files (we use bun exclusively with bun.lock)
package-lock.json

# CLI build output
cli/web-ui/.vite/
cli/web-ui/dist/
