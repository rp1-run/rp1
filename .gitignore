# Generated files (created by build:release / generate:assets)
cli/src/assets/embedded.ts
cli/src/config/supported-tools.generated.ts

# local rp1 binary
bin/rp1

# rp1:start
!.rp1/
.rp1/*
!.rp1/config/
!.rp1/config/**
!.rp1/context/
!.rp1/context/**
.rp1/context/meta.json
.rp1/settings.toml
# rp1:end
# Eval output - attestation results are tracked, .gitkeep placeholder removed
